      "steps": [
        "INSERT INTO baseline_types_ok\n\t\t\t (c_smallint, c_integer, c_bigint, c_real, c_double, c_numeric, c_numeric_ps,\n\t\t\t  c_decimal, c_char, c_varchar, c_bpchar, c_text, c_date, c_time, c_timetz,\n\t\t\t  c_timestamp, c_timestamptz, c_interval, c_boolean, c_bytea, c_uuid, c_json, c_jsonb)\n\t\t\t VALUES (1, 2, 3, 1.5, 2.5, 3.5, 4.5, 5.5, 'abc', 'def', 'ghi', 'jkl',\n\t\t\t  '2026-01-02', '03:04:05', '03:04:05+00', '2026-01-02 03:04:05',\n\t\t\t  '2026-01-02 03:04:05+00', '1 day', true, '\\x6869',\n\t\t\t  '00000000-0000-0000-0000-000000000001', '{\"a\":1}', '{\"b\":2}')",
        "SELECT count(*) FROM baseline_types_ok"
      ],
      "observations": [
        {
          "outcome": "ok",
          "command_tag": "INSERT 0 1"
        },
        {
