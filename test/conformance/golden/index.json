    {
      "name": "create_index_sync",
      "group": "index",
      "note": "DSQL requires ASYNC; sync should be refused",
      "steps": [
        "CREATE INDEX baseline_idx_value ON baseline_idx (value)"
      ],
      "observations": [
        {
          "outcome": "error",
          "sqlstate": "0A000",
          "message": "unsupported mode. please use CREATE INDEX ASYNC."
        }
      ]
    },
    {
      "name": "create_index_async",
